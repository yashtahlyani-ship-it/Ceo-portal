# Root env — used by docker compose, the admin scripts and the test suite.
# Copy to .env and fill in. Both files are gitignored; this repository is public.

# ── Public, compiled into the browser bundle (see frontend/.env.example) ──────
VITE_API_URL=http://localhost:7869
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_cognito_app_client_id

FRONTEND_URL=http://localhost:7868

# ── Database ──────────────────────────────────────────────────────────────────
# docker compose starts a local Postgres with this password. Deployed
# environments use RDS via AWS_SECRET_NAME instead and ignore all of this.
DB_PASSWORD=localdev

# For pointing the scripts and tests at a database directly:
DB_HOST=localhost
DB_PORT=5442
DB_NAME=gyftr_ceo
DB_USER=gyftr_admin

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_app_client_id
ATTACHMENTS_BUCKET=gyftr-ceo-portal-attachments

# Production only — pulls the DB credentials from Secrets Manager, so the
# password never appears in a task definition.
# AWS_SECRET_NAME=gyftr/ceo/db

# ── The password seeded demo accounts share. Server-side only. ────────────────
# Deliberately not hard-coded anywhere: this repository is public.
DEMO_PASSWORD=CHOOSE-A-STRONG-PASSWORD
