# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). The anon key is safe to expose to the browser;
# security is enforced by Row-Level Security, never by hiding the key.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only, NEVER exposed to the browser. Used exclusively by the admin
# scripts in /scripts (create stakeholder accounts, run seed). Keep it in .env
# (not .env.local) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# The password every seeded demo account shares. Server-only, and deliberately
# never hard-coded in the repo — this repository is public and the demo accounts
# are live on a publicly reachable deployment.
#
# Used by `npm run seed` (to set it) and by the integration tests (to sign in).
# Both refuse to run without it. Ask the CEO's Office for the current value, or
# choose your own and re-seed.
DEMO_PASSWORD=CHOOSE-A-STRONG-PASSWORD
