# Root env — used by docker compose, the admin scripts and the test suite.
# Copy to .env and fill in. Both files are gitignored.

# ── Public, shipped in the browser bundle (see frontend/.env.example) ─────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── Server-only. Bypasses Row-Level Security. NEVER expose to the browser. ────
# Used exclusively by scripts/ (seed, onboard) and the integration tests.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── The password every seeded demo account shares. Server-only. ───────────────
# Deliberately not hard-coded anywhere: this repository is public.
DEMO_PASSWORD=CHOOSE-A-STRONG-PASSWORD
