{
  "name": "gyftr-ceo-portal",
  "private": true,
  "version": "2.0.0",
  "description": "GyFTR CEO Office Task Platform — React frontend + Express API on AWS (ECS/RDS/Cognito/S3)",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend && npm install --prefix scripts && npm install",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/logic.test.mjs\" \"tests/routes.test.mjs\"",
    "test:security": "node --test \"tests/security.test.mjs\"",
    "test:api": "node --test \"tests/api.test.mjs\"",
    "seed": "npm --prefix scripts run seed",
    "onboard": "npm --prefix scripts run onboard",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "doctor": "npm --prefix scripts run doctor"
  },
  "devDependencies": {
    "amazon-cognito-identity-js": "^6.3.12",
    "dotenv": "^17.4.2",
    "pg": "^8.11.3"
  }
}
