{
  "name": "gyftr-ceo-portal",
  "private": true,
  "version": "1.0.0",
  "description": "GyFTR CEO Office Task Platform \u2014 frontend + Supabase data layer",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix scripts",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/logic.test.mjs\"",
    "test:security": "node --test \"tests/security.test.mjs\"",
    "seed": "npm --prefix scripts run seed",
    "onboard": "npm --prefix scripts run onboard",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.4.2"
  }
}
